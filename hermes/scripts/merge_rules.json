{
  "version": "1",
  "date": "2026-11-07",
  "note": "影子合并官的判定规则（#61）。思路取自 orca/merge_gate.py（在 claude/37-* 分支）和 docs/DT-ORC/ARCHITECTURE.md 4.2、5.5：完整 HEAD/base 绑定、敏感路径交给人、有硬性问题一律退回、路径只能上调风险。每次被常浩推翻，改这里、版本号加一，并用 merge_officer.py replay 回放历史。",
  "sensitive": [
    "^\\.github/",
    "^ops/",
    "\\.plist$",
    "(^|/)\\.env",
    "\\.(pem|key|p12)$",
    "secret",
    "credential",
    "token",
    "password"
  ],
  "repo_sensitive": {
    "digital-twin": ["^hermes/", "^orca/executor-settings\\.json$", "^orca/merge_gate\\.py$", "^projects\\.json$"]
  },
  "l0_paths": ["\\.md$"],
  "rule_docs": ["(^|/)AGENTS\\.md$", "(^|/)CLAUDE\\.md$", "(^|/)PRD\\.md$", "(^|/)LESSONS\\.md$", "(^|/)SKILL\\.md$"],
  "l1_max_files": 3,
  "return_when": {
    "draft": true,
    "conflicting": true,
    "failing_checks": true,
    "missing_closes": true
  },
  "ask_labels": ["needs-info"],
  "threshold": {"min_samples": 20, "min_rate": 0.9},
  "act": {
    "note": "飞书一句话合并（#67）覆盖的仓库。ci: true 的以 GitHub 检查全部通过为合并条件，不在本机跑测试（#71）；没有 CI 的在干净副本里先跑 setup（装依赖）再跑 test。postpane 按项目约定停用了 GitHub Actions，没有 CI，不走飞书合并（#73）。不影响判定，改这里不用加版本号",
    "repos": {
      "digital-twin": {"ci": true, "test": "python3 -B -m unittest discover -s hermes/scripts/tests", "timeout": 1200},
      "agent-kit": {"ci": true, "test": "node --test tests/*.test.mjs", "timeout": 600},
      "my-skills": {"ci": true},
      "github-center": {"ci": true},
      "trainee-hub": {"ci": true},
      "niuma-home": {"ci": true},
      "digiworld": {"ci": true}
    }
  }
}
